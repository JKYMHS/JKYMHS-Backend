# 이 파일을 복사해서 .env로 만들고 값을 채운다 (.env는 git에 올리지 않는다)
# 주의: "KEY=" 처럼 값을 비워두면 빈 문자열로 설정돼서 application.yml의 기본값을 덮어쓴다.
# 기본값을 쓸 항목은 아래처럼 주석(#) 상태로 두고, 바꿀 항목만 주석을 풀어서 값을 넣는다.

# [데이터 수집] 공공데이터포털 한국관광공사 국문 관광정보 서비스_GW 일반 인증키(Decoding). tools/tourapi/collect.py와 동기화 배치가 읽는다
# TOUR_API_KEY=
# [데이터 수집] TourAPI 하루 호출 한도. 운영 계정으로 한도가 늘면 올린다
# TOUR_API_DAILY_CALL_LIMIT=1000
# [데이터 수집] 동기화 배치 한 번에 운영 시간·쉬는 날을 새로 받을 콘텐츠 수
# TOUR_SYNC_INTRO_PER_RUN=300
# [데이터 수집] 서버 시작 시 적재할 CSV 폴더 (collect.py export 결과). 처음 한 번만 켜고 적재 후 다시 주석 처리해도 된다
# TOUR_IMPORT_CSV_DIR=tools/tourapi/data
# [배치] false면 동기화·인기 점수 등 정해진 시각 배치를 모두 끈다
# BATCH_ENABLED=true
# [배치] 배치 실패 알림을 받을 웹훅 주소 ({"text": "..."}를 POST). 주석 상태면 ERROR 로그만 남긴다
# BATCH_ALERT_WEBHOOK_URL=
# [카카오] 카카오 디벨로퍼스 REST API 키. 출발지 검색(카카오 로컬)과 택시 경로(카카오 모빌리티)가 같이 쓴다
# KAKAO_REST_API_KEY=
