# 이 파일을 복사해서 .env로 만들고 값을 채운다 (.env는 git에 올리지 않는다)
#   cp .env.example .env
# 값이 비어 있는 항목은 application.yml의 기본값(로컬 docker compose)을 쓴다

# [필수] JWT 서명 키: 32자 이상 랜덤 문자열. 생성 예: openssl rand -base64 48
JWT_SECRET=

# [#3 이메일 인증] SMTP. 비워두면 로컬 Mailpit(localhost:1025, 웹 http://localhost:8025)으로 보낸다
# Gmail 예: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_SMTP_AUTH=true MAIL_SMTP_STARTTLS=true (MAIL_PASSWORD는 앱 비밀번호)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
MAIL_FROM=

# [#6 구글 로그인] Google Cloud Console > OAuth 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
