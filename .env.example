# 이 파일을 복사해서 .env로 만들고 값을 채운다 (.env는 git에 올리지 않는다)
#   cp .env.example .env
#
# 주의: "KEY=" 처럼 값을 비워두면 빈 문자열로 설정돼서 application.yml의 기본값을 덮어쓴다.
# 기본값(로컬 docker compose)을 쓸 항목은 아래처럼 주석(#) 상태로 두고, 바꿀 항목만 주석을 풀어서 값을 넣는다.

# [필수] JWT 서명 키: 32자 이상 랜덤 문자열. 생성 예: openssl rand -base64 48
JWT_SECRET=

# [#3 이메일 인증] SMTP. 주석 상태로 두면 로컬 Mailpit(localhost:1025, 받은 메일은 http://localhost:8025)으로 보낸다
# Gmail 예: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true, MAIL_PASSWORD는 앱 비밀번호
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=

# [#6 구글 로그인] Google Cloud Console > OAuth 클라이언트 ID (웹 애플리케이션). 주석 상태면 구글 로그인만 실패하고 서버는 뜬다
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# [#13 리프레시 토큰 쿠키] 주석 상태면 Secure, SameSite=Lax로 내려간다
# Chrome·Firefox는 http://localhost에서도 Secure 쿠키를 받지만 Safari는 받지 않는다. 로컬에서 Safari로 확인할 때만 false로 둔다
# AUTH_COOKIE_SECURE=false
# Strict, Lax, None 중 하나. FE와 API의 사이트(등록 도메인)가 다르면 None이 필요하다. None이면 AUTH_COOKIE_SECURE=false로는 서버가 뜨지 않는다
# AUTH_COOKIE_SAME_SITE=None

# [#13 CORS] 브라우저에서 호출할 FE 주소. 쉼표로 구분하고 스킴과 호스트(포트)만 쓴다. 경로, 끝의 /, *는 서버 시작이 실패한다. 주석 상태면 어떤 Origin도 허용하지 않는다
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://whereto.app

# [데이터 수집] 공공데이터포털 한국관광공사 국문 관광정보 서비스_GW 일반 인증키(Decoding). tools/tourapi/collect.py와 동기화 배치가 읽는다
# TOUR_API_KEY=
# [데이터 수집] TourAPI 하루 호출 한도. 운영 계정으로 한도가 늘면 올린다
# TOUR_API_DAILY_CALL_LIMIT=1000
# [데이터 수집] 동기화 배치 한 번에 운영 시간·쉬는 날을 새로 받을 콘텐츠 수
# TOUR_SYNC_INTRO_PER_RUN=300
# [데이터 수집] 서버 시작 시 적재할 CSV 폴더 (collect.py export 결과). 처음 한 번만 켜고 적재 후 다시 주석 처리해도 된다
# TOUR_IMPORT_CSV_DIR=tools/tourapi/data
# [배치] false면 동기화·인기 점수 등 정해진 시각 배치를 모두 끈다
# BATCH_ENABLED=true
# [배치] 배치 실패 알림을 받을 웹훅 주소 ({"text": "..."}를 POST). 주석 상태면 ERROR 로그만 남긴다
# BATCH_ALERT_WEBHOOK_URL=
# [카카오] 카카오 디벨로퍼스 REST API 키. 출발지 검색(카카오 로컬)과 택시 경로(카카오 모빌리티)가 같이 쓴다
# KAKAO_REST_API_KEY=
# [경로 계산] ODsay LAB 서버용 API 키 (등록한 서버 IP에서만 동작). 주석 상태면 대중교통 경로 없이 택시·어림값으로 답한다
# ODSAY_API_KEY=
# [방문 확인 메일] 메일 속 링크가 가리킬 FE 주소. 주석 상태면 http://localhost:3000
# FRONTEND_BASE_URL=http://localhost:3000
