# 이 파일을 복사해서 .env로 만들고 값을 채운다 (.env는 git에 올리지 않는다)
#   cp .env.example .env
#
# 주의: "KEY=" 처럼 값을 비워두면 빈 문자열로 설정돼서 application.yml의 기본값을 덮어쓴다.
# 기본값(로컬 docker compose)을 쓸 항목은 아래처럼 주석(#) 상태로 두고, 바꿀 항목만 주석을 풀어서 값을 넣는다.

# [필수] JWT 서명 키: 32자 이상 랜덤 문자열. 생성 예: openssl rand -base64 48
JWT_SECRET=

# [#3 이메일 인증] SMTP. 주석 상태로 두면 로컬 Mailpit(localhost:1025, 받은 메일은 http://localhost:8025)으로 보낸다
# Gmail 예: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true, MAIL_PASSWORD는 앱 비밀번호
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=

# [#6 구글 로그인] Google Cloud Console > OAuth 클라이언트 ID (웹 애플리케이션). 주석 상태면 구글 로그인만 실패하고 서버는 뜬다
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
